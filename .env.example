# ─────────────────────────────────────────────────────────────────────────────
# Hanuja Marketplace — Environment Variables Template
#
# Copy this file to .env (gitignored) and fill in real values.
# Never commit real secrets. See docs/05-security/secrets-env-policy.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hanuja_dev"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Better Auth ───────────────────────────────────────────────────────────────
# Must be a long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-long-random-string"

# Each app sets its own BETTER_AUTH_URL (the app's public base URL)
# Web (apps/web):
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cross-panel URLs (used for CORS trusted origins in web app):
SELLER_PANEL_URL="http://localhost:3001"
ADMIN_PANEL_URL="http://localhost:3002"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ── Iyzico Payment ────────────────────────────────────────────────────────────
IYZICO_API_KEY="sandbox-api-key"
IYZICO_SECRET_KEY="sandbox-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# HMAC secret for webhook signature verification — get from Iyzico dashboard
IYZICO_WEBHOOK_SECRET=""

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hanuja-media"
R2_PUBLIC_URL="https://media.yourdomain.com"
# Public hostname used in next.config.ts for Next.js Image optimization allowlist
R2_PUBLIC_HOSTNAME="media.yourdomain.com"

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_URL="http://localhost:7700"
# Generate keys from a running Meilisearch instance:
#   curl -X POST 'http://localhost:7700/keys' \
#     -H 'Authorization: Bearer <MEILI_MASTER_KEY>' \
#     -H 'Content-Type: application/json' \
#     -d '{"name":"Admin Key","actions":["*"],"indexes":["*"],"expiresAt":null}'
# Use the master key value as MEILISEARCH_ADMIN_KEY for indexing operations.
# Create a separate search-only key with actions:["search"] for the frontend.
MEILISEARCH_ADMIN_KEY=""
MEILISEARCH_SEARCH_KEY=""

# ── SMTP (email — password reset, notifications) ────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hanuja <no-reply@hanuja.com>"

# ── App metadata ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Hanuja"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
