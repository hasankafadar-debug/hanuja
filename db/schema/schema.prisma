// =============================================================================
// Hanuja Marketplace — Prisma Schema
// =============================================================================
// Tüm business rule'lar .claude/rules/ ve docs/ dosyalarından türetilmiştir.
// Payout countdown başlangıcı: delivery_confirmed (delivered değil).
// Satıcı yalnızca payment_confirmed siparişleri görür.
// Satıcı ledger'ı her finansal hareketi kayıt altına alır.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  customer
  seller
  admin
}

enum SellerStatus {
  pending // Başvuru yapıldı, inceleniyor
  active // Onaylı, aktif satıcı
  suspended // Geçici olarak askıya alındı
  rejected // Başvurusu reddedildi
}

enum SellerDocumentType {
  identity // TC Kimlik / Pasaport
  tax_certificate // Vergi Levhası
  trade_registry // Ticaret Sicil Gazetesi / Esnaf Sicil Belgesi
  signature_circular // İmza Sirküleri (tüzel kişiler)
  bank_statement // Banka Hesap Cüzdanı / IBAN Belgesi
  other // Diğer
}

enum SellerDocumentStatus {
  pending // Yüklendi, admin incelemesi bekliyor
  approved // Admin onayladı
  rejected // Admin reddetti
}

enum BankDetailStatus {
  ACTIVE
  PENDING_ACTIVATION
  BLOCKED
  SUPERSEDED
  CANCELLED
}

enum ProductStatus {
  draft // Taslak — henüz gönderilmedi
  pending_review // İnceleme bekliyor
  published // Yayında, alışverişe açık
  unlisted // Yayından kaldırıldı (satıcı/admin)
  rejected // Moderasyon tarafından reddedildi
}

enum DiscountRuleScope {
  ALL_PRODUCTS
  CATEGORY
  PRODUCT
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  PAUSED
}

// Sipariş lifecycle — 08-order-lifecycle-rules.md
// payment, fulfillment, cancellation, return, refund durumları birleştirilmiştir.
// payout_hold/payout_blocked gibi payout durumları Payout modelinde tutulur.
enum OrderStatus {
  // -- Oluşturma ve ödeme --
  draft
  checkout_started
  payment_pending
  bank_transfer_waiting // Havale/EFT bekleniyor
  bank_transfer_confirmed // Havale/EFT admin tarafından onaylandı
  payment_confirmed // Ödeme onaylı — satıcıya gönderilecek
  payment_failed
  payment_cancelled

  // -- Satıcı akışı (yalnızca payment_confirmed sonrası) --
  seller_queue_ready // Satıcı kuyruğuna düştü
  seller_reviewing // Satıcı inceliyor
  seller_accepted // Satıcı onayladı
  seller_rejected // Satıcı reddetti → ceza değerlendirmesi
  preparing // Hazırlanıyor
  awaiting_shipment // Kargo teslim bekliyor

  // -- Kargo ve teslimat --
  shipped // Kargoya verildi
  delivered // Kargoda teslim edildi (≠ delivery_confirmed)
  delivery_confirmation_pending // Müşteri onayı bekleniyor
  delivery_confirmed // Teslim onaylandı → payout countdown başlar

  // -- İptal (nedene göre ayrı) --
  cancelled_by_customer
  cancelled_by_admin
  cancelled_due_to_payment_failure
  cancelled_due_to_seller_rejection
  cancelled_due_to_20day_breach // 20 günlük yükümlülük ihlali

  // -- İade ve uyuşmazlık --
  return_requested
  return_under_review
  return_approved
  return_rejected
  return_in_transit // Müşteri kargo ile iade ediyor
  return_received // Ürün alındı
  refund_pending
  refund_completed
  dispute_open
  dispute_resolved
}

enum PaymentMethod {
  card // Kredi/banka kartı (Iyzico)
  eft // Havale/EFT (manuel onay gerekir)
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded
  chargebacked
  cancelled
}

enum ShipmentStatus {
  preparing
  handed_to_cargo
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned_to_sender
}

// Payout lifecycle — 07-marketplace-finance-rules.md
// Countdown: delivery_confirmed'dan 30 gün sonra
enum PayoutStatus {
  hold_active // 30 günlük bekletme dönemi aktif
  payout_blocked // İade/uyuşmazlık/fraud/admin hold nedeniyle bloke
  payout_ready // Tüm koşullar sağlandı, ödeme yapılabilir
  payout_scheduled // Toplu ödeme kuyruğuna alındı
  payout_paid // Ödeme gerçekleşti
}

enum PenaltyStatus {
  applied // Uygulandı, ledger'a yazıldı
  waived // Admin tarafından muaf tutuldu (gerekçeli)
  offset // Gelecek ödemeden mahsup edildi
}

enum PenaltyReason {
  seller_rejected_paid_order // Sat?c? onayl? sipari?i reddetti
  fulfillment_20day_breach // 20 g?nl?k teslimat y?k?ml?l??? ihlali
  late_shipment_daily_accrual // Sevk gecikmesinde g?nl?k %1 ceza birikimi
  other // Admin karar? ile di?er ceza
}

enum OrderCancellationReason {
  customer_requested
  admin_cancelled
  payment_failed
  seller_rejected
  auto_canceled_20day_breach
  other
}

enum SellerInvoiceType {
  commission
  penalty
}

enum FulfillmentRiskStatus {
  warning
  breached
  resolved
}

enum ReturnRequestStatus {
  requested // İade talep edildi
  under_review // İnceleniyor
  approved // Onaylandı
  rejected // Reddedildi
  in_transit // Müşteri ürünü kargoya verdi
  received // Ürün alındı
  refund_completed
}

enum DisputeStatus {
  open
  under_review
  resolved_for_customer
  resolved_for_seller
  closed
}

// Satıcı ledger kayıt türleri — 07-marketplace-finance-rules.md
enum LedgerEntryType {
  sale // Satış geliri
  commission // Komisyon kesintisi
  cargo_charge // Kargo kesintisi
  ad_fee // Reklam/hizmet ücreti
  penalty // Ceza kesintisi
  refund // İade etkisi
  coupon_share // Kupon payı
  eft_discount // Admin havale onayında uygulanan indirim
  manual_adjustment // Admin manuel düzeltme
  payout // Ödeme (negatif — hesaptan çıkış)
  chargeback // Chargeback
  dispute_hold // Uyuşmazlık bloku
  dispute_release // Uyuşmazlık çözümü sonrası serbest bırakma
}

enum AdminActionType {
  payment_approved
  payment_rejected
  bank_transfer_approved
  bank_transfer_rejected
  order_cancelled
  delivery_confirmed_manual
  penalty_applied
  penalty_waived
  payout_released
  payout_blocked
  payout_hold_released
  seller_suspended
  seller_activated
  seller_rejected
  return_approved
  return_rejected
  dispute_opened
  dispute_resolved
  manual_ledger_adjustment
  fulfillment_window_extended
  seller_bank_detail_changed
  seller_bank_detail_approved
  seller_bank_detail_blocked
  seller_document_approved
  seller_document_rejected
  seller_documents_requested
  seller_password_reset_by_admin
  home_slide_created
  home_slide_updated
  home_slide_deleted
  home_slide_reordered
  home_promo_updated
  product_review_approved
  product_review_rejected
  seller_products_imported
  seller_import_permission_granted
  category_tax_rate_changed
}

enum HomePromoSlot {
  TOP_RIGHT
  BOTTOM_RIGHT
}

enum NotificationType {
  order_placed
  order_payment_confirmed
  order_shipped
  order_delivered
  order_delivery_confirmed
  order_canceled
  order_cancelled
  order_return_approved
  order_return_rejected
  return_requested
  return_status_changed
  refund_completed
  payout_ready
  payout_paid
  seller_order_received
  seller_payout_ready
  seller_payout_paid
  seller_penalty_applied
  seller_return_request
  penalty_applied
  dispute_opened
  dispute_resolved
  admin_bank_transfer_pending
  admin_dispute_opened
  account_verified
  seller_approved
  seller_suspended
  seller_bank_detail_pending
  seller_bank_detail_approved
  seller_bank_detail_activated
  seller_bank_detail_blocked
  seller_support_reply
  admin_support_new_ticket
  invoice_uploaded
  product_review_pending_moderation
  product_review_approved
  product_review_rejected
}

enum SupportTicketStatus {
  waiting_for_admin
  waiting_for_seller
  resolved
}

enum MediaAssetType {
  product_image
  store_image
  blog_image
  dispute_evidence
  return_evidence
  invoice_document
  support_attachment
}

enum MediaAssetKind {
  image
  document
  video
}

// Ana sayfa CMS — slider/promo içerik durumları
enum HomeCmsStatus {
  active
  paused
  scheduled
  expired
}

enum BlogPostStatus {
  draft
  published
  archived
}

// Ürün değerlendirme moderasyon durumu — 06-content-guidelines moderation rules
enum ProductReviewStatus {
  pending_moderation // Yüklendi, admin onayı bekliyor
  approved // Onaylandı, ürün sayfasında görünür
  rejected // Reddedildi, görünmez
}

// =============================================================================
// AUTH — Better Auth uyumlu
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  emailVerified      Boolean   @default(false)
  image              String?
  role               UserRole  @default(customer)
  mustChangePassword Boolean   @default(false)
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Better Auth ilişkileri
  sessions Session[]
  accounts Account[]

  // Domain ilişkileri
  seller                Seller?
  addresses             Address[]
  cart                  Cart?
  orders                Order[]
  notifications         Notification[]
  couponUsages          CouponUsage[]
  supportMessages       SupportMessage[]
  productReviews        ProductReview[]
  favorites             FavoriteProduct[]
  paidPayouts           Payout[]          @relation("PayoutPaidByAdmin")
  createdSellerInvoices SellerInvoice[]   @relation("SellerInvoiceCreatedByAdmin")

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// =============================================================================
// SELLER — Satıcı profili, banka bilgisi, finansal hesap
// =============================================================================

model Seller {
  id                    String       @id @default(cuid())
  userId                String       @unique
  slug                  String       @unique // /magaza/<slug> SEO route'u
  displayName           String
  sellerNumber          Int          @unique @default(autoincrement())
  status                SellerStatus @default(pending)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  documentsRequestedAt  DateTime?
  requiredDocumentTypes Json?
  importEnabled         Boolean      @default(false)
  importRequestedAt     DateTime?

  user              User                      @relation(fields: [userId], references: [id])
  profile           SellerProfile?
  bankDetails       SellerBankDetail[]
  bankDetailHistory SellerBankDetailHistory[]
  documents         SellerDocument[]
  ledgerEntries     SellerLedgerEntry[]
  products          Product[]
  discountRules     DiscountRule[]
  orderLines        OrderLine[]
  orderInvoices     OrderSellerInvoice[]
  orderEmailAliases OrderEmailAlias[]
  shipments         Shipment[]
  payouts           Payout[]
  penalties         Penalty[]
  sellerInvoices    SellerInvoice[]
  fulfillmentRisks  FulfillmentRisk[]
  supportTickets    SupportTicket[]
  homeSlides        HomeSlide[]

  @@index([status])
  @@index([slug])
  @@map("sellers")
}

model SellerProfile {
  id           String    @id @default(cuid())
  sellerId     String    @unique
  bio          String?
  story        String?
  logoUrl      String?
  bannerUrl    String?
  companyName  String?
  city         String?
  district     String?
  postalCode   String?
  legalAddress String?
  phone        String?
  taxOffice    String?
  taxNumber    String? // Vergi numarası (masked in non-admin views)
  mersis       String?
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id])

  @@map("seller_profiles")
}

// Satıcı banka/IBAN bilgisi — kritik güvenlik alanı, her değişiklik loglanır
model SellerBankDetail {
  id                 String           @id @default(cuid())
  sellerId           String
  iban               String // Şifreli/masked saklanmalı — açık metne sadece payout akışında erişilir
  accountHolder      String
  bankName           String
  status             BankDetailStatus @default(PENDING_ACTIVATION)
  isActive           Boolean          @default(false) // Geciktirmeli aktivasyon — admin/sistem onayı gerekebilir
  isVerified         Boolean          @default(false)
  verifiedAt         DateTime?
  verifiedBy         String?
  activatedAt        DateTime?
  activatesAt        DateTime?
  stepUpVerifiedAt   DateTime?
  previousIbanMasked String?
  changeReason       String?
  blockedReason      String?
  blockedAt          DateTime?
  blockedBy          String?
  cancelledAt        DateTime?
  flags              Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller  Seller                    @relation(fields: [sellerId], references: [id])
  payouts Payout[]
  history SellerBankDetailHistory[]

  @@index([sellerId, isActive])
  @@index([sellerId, status, activatesAt])
  @@map("seller_bank_details")
}

model SellerBankDetailHistory {
  id                 String   @id @default(cuid())
  sellerId           String
  bankDetailId       String?
  action             String
  ibanMasked         String
  previousIbanMasked String?
  actorId            String
  actorRole          String
  ip                 String?
  userAgent          String?
  reason             String?
  createdAt          DateTime @default(now())

  seller     Seller            @relation(fields: [sellerId], references: [id])
  bankDetail SellerBankDetail? @relation(fields: [bankDetailId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@index([bankDetailId])
  @@map("seller_bank_detail_history")
}

// Satıcı KYC belgeleri — kimlik, vergi, sicil, imza belgesi vb.
// Her belge ayrı bir kayıt; aynı tipten birden fazla yükleme mümkün (son=geçerli).
model SellerDocument {
  id         String               @id @default(cuid())
  sellerId   String
  type       SellerDocumentType
  status     SellerDocumentStatus @default(pending)
  fileUrl    String // R2 CDN public URL
  fileKey    String // R2 storage key — delete için gerekli
  fileName   String // Orijinal dosya adı (yalnızca bilgi amaçlı)
  mimeType   String // image/jpeg | image/png | application/pdf
  sizeBytes  Int
  adminNote  String? // Admin red/onay notu
  reviewedBy String? // Admin kullanıcı ID
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([sellerId, type])
  @@index([status])
  @@map("seller_documents")
}

// Satıcı finansal ledger'ı — her finansal hareket buraya kayıt edilir
// Her kayıt immutable: üzerine yazma yok, yalnızca yeni kayıt eklenir
model SellerLedgerEntry {
  id            String          @id @default(cuid())
  sellerId      String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2) // Pozitif = giriş, negatif = çıkış
  balanceAfter  Decimal         @db.Decimal(12, 2) // Bu kayıt sonrası güncel bakiye
  referenceType String // 'order' | 'payout' | 'penalty' | 'manual' vb.
  referenceId   String // İlgili kaydın ID'si
  description   String? // İnsan okunabilir açıklama
  createdAt     DateTime        @default(now())
  createdBy     String? // Admin action'dan geliyorsa actor ID

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([referenceType, referenceId])
  @@map("seller_ledger_entries")
}

// =============================================================================
// CATALOG — Kategori, Ürün, Görsel, Varyant
// =============================================================================

model Category {
  id                 String    @id @default(cuid())
  slug               String    @unique // /kategori/<slug>
  name               String
  description        String?
  imageUrl           String?
  parentId           String?
  sortOrder          Int       @default(0)
  isActive           Boolean   @default(true)
  taxRate            Decimal?  @db.Decimal(5, 4) // KDV oranı; boşsa üst kategori / platform varsayılanı kullanılır
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdViaImportBy String? // Seller.id — import commit ile açıldıysa; null = admin/seed
  createdViaImportAt DateTime? // Import commit zamanı

  parent        Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryTree")
  products      Product[]
  discountRules DiscountRule[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  sellerId         String
  categoryId       String?
  slug             String        @unique // /urun/<slug>
  name             String
  description      String?
  shortDescription String?
  story            String? // Ürün Hikayesi
  careInstructions String? // Bakım Tavsiyesi
  status           ProductStatus @default(draft)
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  stockQuantity    Int           @default(0)
  sku              String?
  barcode          String?       @unique @db.VarChar(13)
  weight           Decimal?      @db.Decimal(8, 3) // kg
  // Boyutlar (cm)
  dimensionLength  Decimal?      @db.Decimal(8, 2)
  dimensionWidth   Decimal?      @db.Decimal(8, 2)
  dimensionHeight  Decimal?      @db.Decimal(8, 2)

  // Aggregate review fields — recomputed on review approve/reject
  avgRating   Decimal? @db.Decimal(3, 2) // 0.00 — 5.00
  reviewCount Int      @default(0)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  publishedAt        DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  moderationFindings Json?

  seller               Seller                @relation(fields: [sellerId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  discountRuleProducts DiscountRuleProduct[]
  images               ProductImage[]
  variants             ProductVariant[]
  orderLines           OrderLine[]
  reviews              ProductReview[]
  favoritedBy          FavoriteProduct[]

  @@index([sellerId, status])
  @@index([barcode])
  @@index([categoryId, status])
  @@index([slug])
  @@index([sellerId, sku])
  @@map("products")
}

model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorite_products")
}

model DiscountRule {
  id         String            @id @default(cuid())
  sellerId   String
  name       String
  scope      DiscountRuleScope
  type       DiscountType
  value      Decimal           @db.Decimal(10, 2)
  categoryId String?
  status     DiscountStatus    @default(ACTIVE)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  seller   Seller                @relation(fields: [sellerId], references: [id])
  category Category?             @relation(fields: [categoryId], references: [id])
  products DiscountRuleProduct[]

  @@index([sellerId, status])
  @@index([categoryId])
  @@map("discount_rules")
}

model DiscountRuleProduct {
  discountRuleId String
  productId      String

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountRuleId, productId])
  @@index([productId])
  @@map("discount_rule_products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String // Örn: "Renk: Krem / Beden: L"
  sku           String?
  barcode       String   @unique @db.VarChar(13)
  price         Decimal? @db.Decimal(12, 2) // null ise ürün fiyatı geçerli
  stockQuantity Int      @default(0)
  options       Json // { "Renk": "Krem", "Beden": "L" }
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

// =============================================================================
// CART — Sepet
// =============================================================================

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  sessionId  String?  @unique // Guest cart
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // Sepete eklendiği andaki fiyat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// =============================================================================
// ADDRESS — Adres
// =============================================================================

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String? // "Ev", "İş"
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  district     String
  city         String
  postalCode   String
  country      String   @default("TR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// =============================================================================
// ORDER — Sipariş lifecycle
// =============================================================================

model Order {
  id                 String                   @id @default(cuid())
  publicNumber       Int                      @unique @default(autoincrement())
  customerId         String
  addressId          String?
  status             OrderStatus              @default(draft)
  currency           String                   @default("TRY")
  cancellationReason OrderCancellationReason?

  // Finansal alanlar — ayrı ayrı tutulur (vague toplam yok)
  grossAmount             Decimal  @db.Decimal(12, 2) // Sepet toplam?
  netSubtotal             Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal  @default(0) @db.Decimal(12, 2)
  shippingAmount          Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal  @default(0) @db.Decimal(12, 2) // ?r?n fiyatlar?na dahil KDV tutar?
  taxBreakdownJson        Json?
  eftDiscountAmount       Decimal  @default(0) @db.Decimal(12, 2)
  eftDiscountRateSnapshot Decimal? @db.Decimal(5, 4)
  totalAmount             Decimal  @db.Decimal(12, 2) // M??terinin ?dedi?i tutar

  couponCode String?
  notes      String?

  // Önemli zaman damgaları
  paymentConfirmedAt  DateTime?
  sellerQueueReadyAt  DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  deliveryConfirmedAt DateTime? // Payout countdown bu tarihten başlar
  cancelledAt         DateTime?
  refundCompletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        User                 @relation(fields: [customerId], references: [id])
  address         Address?             @relation(fields: [addressId], references: [id])
  lines           OrderLine[]
  payments        Payment[]
  shipments       Shipment[]
  statusHistory   OrderStatusHistory[]
  legalSnapshot   OrderLegalSnapshot?
  sellerInvoices  OrderSellerInvoice[]
  emailAliases    OrderEmailAlias[]
  inboundEmails   InboundEmail[]
  payouts         Payout[]
  penalties       Penalty[]
  financeInvoices SellerInvoice[]      @relation("SellerInvoiceOrder")
  fulfillmentRisk FulfillmentRisk?
  returnRequests  ReturnRequest[]
  disputes        Dispute[]
  couponUsage     CouponUsage?
  supportTickets  SupportTicket[]
  productReviews  ProductReview[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([publicNumber])
  @@map("orders")
}

model OrderLegalSnapshot {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  distanceSalesHtml  String   @db.Text
  preInformationHtml String   @db.Text
  buyerSnapshot      Json
  sellerSnapshot     Json
  platformSnapshot   Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_legal_snapshots")
}

model OrderSellerInvoice {
  id             String   @id @default(cuid())
  orderId        String
  sellerId       String
  inboundEmailId String?  @unique
  fileUrl        String
  fileKey        String
  fileName       String
  mimeType       String
  sizeBytes      Int
  source         String   @default("manual")
  uploadedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller       Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inboundEmail InboundEmail? @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)

  @@unique([orderId, sellerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([source])
  @@map("order_seller_invoices")
}

model OrderEmailAlias {
  id            String    @id @default(cuid())
  orderId       String
  sellerId      String
  aliasEmail    String    @unique
  localPart     String    @unique
  purpose       String    @default("invoice")
  status        String    @default("active")
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([orderId, sellerId, purpose])
  @@index([sellerId, status])
  @@index([orderId])
  @@map("order_email_aliases")
}

model InboundEmail {
  id                 String   @id @default(cuid())
  messageId          String   @unique
  orderId            String?
  sellerId           String?
  aliasEmail         String
  fromEmail          String?
  subject            String?
  status             String
  selectedAttachment Json?
  errorReason        String?
  receivedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order   Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice OrderSellerInvoice?

  @@index([aliasEmail])
  @@index([orderId])
  @@index([status])
  @@map("inbound_emails")
}

model OrderLine {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  sellerId         String
  variantId        String?
  productName      String // Sipariş anındaki ürün adı snapshot
  variantName      String? // Sipariş anındaki varyant snapshot
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2) // Sipariş anındaki fiyat snapshot
  totalPrice       Decimal @db.Decimal(12, 2)
  taxRate          Decimal @default(0) @db.Decimal(5, 4)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2) // Satır toplamına dahil KDV
  // Satıcı payout hesabı için
  commissionRate   Decimal @default(0) @db.Decimal(5, 4) // Örn: 0.1500 = %15
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  netPayoutAmount  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  seller  Seller  @relation(fields: [sellerId], references: [id])
  payout  Payout?

  @@index([orderId])
  @@index([sellerId])
  @@map("order_lines")
}

model FulfillmentRisk {
  id               String                @id @default(cuid())
  orderId          String                @unique
  sellerId         String
  status           FulfillmentRiskStatus
  deadlineAt       DateTime
  warningStartedAt DateTime?
  breachedAt       DateTime?
  resolvedAt       DateTime?
  lastSeenAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([status, deadlineAt])
  @@map("fulfillment_risks")
}

// Sipariş durum geçmişi — append-only, üzerine yazma yok
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String? // Değişikliği yapan kullanıcı ID'si
  actorRole  UserRole?
  reason     String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// =============================================================================
// PAYMENT — Ödeme
// =============================================================================

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  method              PaymentMethod
  status              PaymentStatus @default(pending)
  currency            String        @default("TRY")
  amount              Decimal       @db.Decimal(12, 2)
  // Iyzico entegrasyon alanları
  providerPaymentId   String? // Iyzico conversation ID veya payment ID
  providerReferenceId String?
  providerData        Json? // Raw provider response (audit için)
  // EFT/Havale için
  eftSenderName       String?
  eftConfirmedBy      String? // Admin actor ID
  eftConfirmedAt      DateTime?
  eftRejectedBy       String?
  eftRejectedAt       DateTime?
  eftRejectionReason  String?
  eftDiscountAmount   Decimal?      @db.Decimal(12, 2) // Admin tarafından uygulanan indirim tutarı
  eftDiscountReason   String? // İndirim gerekçesi
  // Timing
  confirmedAt         DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Ödeme olayları — webhook, callback, manuel değişiklikler
model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  eventType   String // 'webhook_received' | 'status_changed' | 'refund_initiated' vb.
  payload     Json? // Orijinal event verisi
  processedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

// =============================================================================
// SHIPMENT — Kargo
// =============================================================================

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String
  sellerId            String
  cargoProvider       String // "yurtiçi" | "aras" | "ptt" | "mng" | "sürat"
  trackingNumber      String?
  status              ShipmentStatus @default(preparing)
  handedAt            DateTime? // Kargoya teslim edildiği an
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id])
  seller Seller          @relation(fields: [sellerId], references: [id])
  events ShipmentEvent[]

  @@index([orderId])
  @@index([sellerId])
  @@map("shipments")
}

// Kargo durum olayları — kargo entegrasyonu veya manuel güncelleme
model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String?
  source      String         @default("manual") // 'cargo_integration' | 'manual' | 'admin'
  occurredAt  DateTime
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipment_events")
}

// =============================================================================
// PAYOUT — Satıcı ödemesi
// =============================================================================

// Her OrderLine için ayrı Payout kaydı olabilir veya tek Order için tek Payout.
// Bu implementasyonda Order bazlı Payout kullanıyoruz.
// Countdown başlangıcı: order.deliveryConfirmedAt + 30 gün
model Payout {
  id           String       @id @default(cuid())
  sellerId     String
  orderId      String
  orderLineId  String?      @unique
  bankDetailId String?
  status       PayoutStatus @default(hold_active)
  currency     String       @default("TRY")

  // Payout hesabı — 07-marketplace-finance-rules.md net_payout formula
  grossAmount       Decimal @db.Decimal(12, 2)
  commissionAmount  Decimal @default(0) @db.Decimal(12, 2)
  couponShareAmount Decimal @default(0) @db.Decimal(12, 2)
  cargoChargeAmount Decimal @default(0) @db.Decimal(12, 2)
  adFeeAmount       Decimal @default(0) @db.Decimal(12, 2)
  penaltyAmount     Decimal @default(0) @db.Decimal(12, 2)
  refundAmount      Decimal @default(0) @db.Decimal(12, 2)
  adjustmentAmount  Decimal @default(0) @db.Decimal(12, 2) // Manuel düzeltme
  netAmount         Decimal @db.Decimal(12, 2) // Nihai ödeme tutarı

  // Hold period
  holdStartedAt DateTime? // deliveryConfirmedAt ile aynı
  holdUntil     DateTime? // holdStartedAt + 30 gün
  blockedReason String? // Neden bloke — görünür olmalı

  batchId               String? // PayoutBatch ilişkisi
  paidAt                DateTime?
  transferReference     String?
  transferDate          DateTime?
  transferBankName      String?
  transferNote          String?
  paidByAdminId         String?
  ibanSnapshot          String?
  accountHolderSnapshot String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  seller          Seller            @relation(fields: [sellerId], references: [id])
  order           Order             @relation(fields: [orderId], references: [id])
  orderLine       OrderLine?        @relation(fields: [orderLineId], references: [id])
  bankDetail      SellerBankDetail? @relation(fields: [bankDetailId], references: [id])
  batch           PayoutBatch?      @relation(fields: [batchId], references: [id])
  paidByAdmin     User?             @relation("PayoutPaidByAdmin", fields: [paidByAdminId], references: [id])
  financeInvoices SellerInvoice[]   @relation("SellerInvoicePayout")

  @@index([sellerId, status])
  @@index([orderId])
  @@index([holdUntil, status])
  @@index([paidByAdminId])
  @@map("payouts")
}

// Toplu ödeme partisi
model PayoutBatch {
  id          String    @id @default(cuid())
  reference   String    @unique // İnsan okunabilir referans kodu
  totalAmount Decimal   @db.Decimal(14, 2)
  sellerCount Int       @default(0)
  payoutCount Int       @default(0)
  processedBy String? // Admin actor ID
  processedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  payouts Payout[]

  @@map("payout_batches")
}

// =============================================================================
// PENALTY — Ceza
// =============================================================================

// Standart ceza oranı: %20 (CLAUDE.md 2.4)
model Penalty {
  id                String        @id @default(cuid())
  sellerId          String
  orderId           String
  reason            PenaltyReason
  status            PenaltyStatus @default(applied)
  baseAmount        Decimal       @db.Decimal(12, 2) // Ürün fiyatı
  rate              Decimal       @default(0.2000) @db.Decimal(5, 4) // %20
  penaltyAmount     Decimal       @db.Decimal(12, 2) // baseAmount * rate
  // Muafiyet
  waivedBy          String? // Admin actor ID
  waivedAt          DateTime?
  waiverReason      String?
  // Mahsup
  offsetPayoutId    String? // Hangi payout'tan mahsup edildi
  accrualSourceDate DateTime?
  accrualDayCount   Int?
  dailyAccrualRate  Decimal?      @default(0.0100) @db.Decimal(5, 4)
  lastAccrualAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller          Seller          @relation(fields: [sellerId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id])
  financeInvoices SellerInvoice[] @relation("SellerInvoicePenalty")

  @@index([sellerId, status])
  @@index([orderId])
  @@map("penalties")
}

model SellerInvoice {
  id               String            @id @default(cuid())
  sellerId         String
  type             SellerInvoiceType
  invoiceNumber    String            @unique
  invoiceDate      DateTime
  invoiceCategory  String?
  description      String?
  amount           Decimal           @db.Decimal(12, 2)
  sourceOrderId    String?
  sourcePenaltyId  String?
  payoutId         String?
  createdByAdminId String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sourceOrder    Order?   @relation("SellerInvoiceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourcePenalty  Penalty? @relation("SellerInvoicePenalty", fields: [sourcePenaltyId], references: [id], onDelete: SetNull)
  payout         Payout?  @relation("SellerInvoicePayout", fields: [payoutId], references: [id], onDelete: SetNull)
  createdByAdmin User     @relation("SellerInvoiceCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([sellerId, type])
  @@index([sourceOrderId])
  @@index([sourcePenaltyId])
  @@index([payoutId])
  @@index([createdByAdminId])
  @@map("seller_invoices")
}

// =============================================================================
// RETURN & DISPUTE — İade ve Uyuşmazlık
// =============================================================================

model ReturnRequest {
  id                   String              @id @default(cuid())
  orderId              String
  customerId           String
  status               ReturnRequestStatus @default(requested)
  reason               String
  description          String?
  isWithinWindow       Boolean // 14 günlük cayma hakkı içinde mi
  // İade kargo bilgisi
  returnTrackingNumber String?
  returnCargoProvider  String?
  // Çözüm
  reviewedBy           String? // Admin actor ID
  reviewedAt           DateTime?
  reviewNote           String?
  itemReceivedAt       DateTime?
  // Finansal etki
  refundAmount         Decimal?            @db.Decimal(12, 2)
  refundedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order           @relation(fields: [orderId], references: [id])
  messages  ReturnMessage[]
  disputeId String?
  evidence  MediaAsset[]

  @@index([orderId])
  @@index([customerId])
  @@map("return_requests")
}

model ReturnMessage {
  id              String   @id @default(cuid())
  returnRequestId String
  authorId        String
  authorRole      UserRole
  body            String
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])

  @@index([returnRequestId])
  @@map("return_messages")
}

model Dispute {
  id            String        @id @default(cuid())
  orderId       String
  openedById    String
  status        DisputeStatus @default(open)
  reason        String
  description   String?
  // Çözüm
  resolvedBy    String? // Admin actor ID
  resolvedAt    DateTime?
  resolution    String?
  // Finansal etki
  payoutBlocked Boolean       @default(true)
  refundAmount  Decimal?      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  messages DisputeMessage[]
  evidence MediaAsset[]

  @@index([orderId])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  authorId   String
  authorRole UserRole
  body       String
  createdAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

// =============================================================================
// CONTENT — Blog, Sayfa
// =============================================================================

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique // /blog/<slug>
  title       String
  summary     String?
  body        String
  coverUrl    String?
  status      BlogPostStatus @default(draft)
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@map("blog_posts")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // /sayfa/<slug>
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// =============================================================================
// HOME CMS — Ana sayfa hero slider ve promo kartlar
// Admin paneli /admin/anasayfa üzerinden yönetilir.
// Storefront 5 dakika cache kullanır (revalidate: 300).
// =============================================================================

// Ana sayfa hero slider slaytları — N slayt destekler
model HomeSlide {
  id String @id @default(cuid())

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // Medya — görsel veya video (MediaAsset.kind = image | video)
  mediaAssetId String
  mediaAsset   MediaAsset @relation("HomeSlideMedia", fields: [mediaAssetId], references: [id])

  // Video ise poster (autoplay öncesi ve düşük bant genişliğinde fallback — zorunlu)
  posterAssetId String?
  posterAsset   MediaAsset? @relation("HomeSlidePoster", fields: [posterAssetId], references: [id])

  // İçerik
  eyebrow  String? @db.VarChar(60) // "YENİ KOLEKSİYON" / "%30 İNDİRİM"
  title    String  @db.VarChar(120)
  body     String? @db.VarChar(300)
  ctaLabel String  @db.VarChar(40)
  ctaHref  String  @db.VarChar(500)

  // Zamanlama penceresi — null = hep aktif
  startsAt DateTime?
  endsAt   DateTime?

  // İsteğe bağlı satıcı ataması (kampanya analytics için)
  sellerId String?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // Admin User.id

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@index([sellerId])
  @@map("home_slides")
}

// Ana sayfa sağ sütun promo kartları — sabit 2 slot
model HomePromo {
  id   String        @id @default(cuid())
  slot HomePromoSlot @unique // Her slot için tek aktif kayıt

  isActive Boolean @default(true)

  // Sadece görsel — videoya izin yok
  mediaAssetId String
  mediaAsset   MediaAsset @relation("HomePromoMedia", fields: [mediaAssetId], references: [id])

  title    String  @db.VarChar(80)
  subtitle String? @db.VarChar(160)
  ctaHref  String  @db.VarChar(500)

  // Zamanlama penceresi — null = hep aktif
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // Admin User.id

  @@index([slot, isActive])
  @@map("home_promos")
}

// =============================================================================
// MEDIA ASSET — Medya dosyaları (Cloudflare R2)
// =============================================================================

model MediaAsset {
  id              String         @id @default(cuid())
  type            MediaAssetType
  kind            MediaAssetKind @default(image)
  url             String // R2 CDN public URL
  key             String? // R2 storage key — required for delete/verify
  folder          String? // products | stores | avatars | disputes | returns | blog | slider | promo
  status          String         @default("ready") // pending | ready | failed
  originalName    String?
  mimeType        String?
  sizeBytes       Int?
  width           Int? // original image width px
  height          Int? // original image height px
  durationSec     Int? // video duration — validated ≤ 15 sec for slider
  variants        Json? // { "1200w": url, "800w": url, "400w": url }
  uploadedBy      String // user/seller ID who owns this asset
  verifiedAt      DateTime? // Set by media-processing job after R2 verification
  // Polymorphic relations — nullable, set when asset is attached to a record
  returnRequestId String?
  disputeId       String?
  createdAt       DateTime       @default(now())

  returnRequest      ReturnRequest?             @relation(fields: [returnRequestId], references: [id])
  dispute            Dispute?                   @relation(fields: [disputeId], references: [id])
  supportAttachments SupportMessageAttachment[]
  // Home CMS ilişkileri — bir asset birden fazla slotta kullanılabilir
  homeSlideMedia     HomeSlide[]                @relation("HomeSlideMedia")
  homeSlidePoster    HomeSlide[]                @relation("HomeSlidePoster")
  homePromoMedia     HomePromo[]                @relation("HomePromoMedia")

  @@index([uploadedBy])
  @@index([uploadedBy, folder, status])
  @@map("media_assets")
}

model SupportTicket {
  id                  String              @id @default(cuid())
  sellerId            String
  orderId             String?
  subject             String
  status              SupportTicketStatus @default(waiting_for_admin)
  resolvedAt          DateTime?
  lastSellerMessageAt DateTime?
  lastAdminMessageAt  DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  seller   Seller           @relation(fields: [sellerId], references: [id])
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([sellerId, status, updatedAt])
  @@index([orderId])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole UserRole
  body       String
  createdAt  DateTime @default(now())

  ticket      SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments SupportMessageAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("support_messages")
}

model SupportMessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  mediaAssetId String
  createdAt    DateTime @default(now())

  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([messageId, mediaAssetId])
  @@index([messageId])
  @@index([mediaAssetId])
  @@map("support_message_attachments")
}

model PlatformSettings {
  id                       String   @id @default("platform")
  standardPenaltyRate      Decimal  @default(0.2000) @db.Decimal(5, 4)
  fulfillmentDays          Int      @default(20)
  fulfillmentWarningDays   Int      @default(5)
  payoutHoldDays           Int      @default(30)
  freeShippingThresholdTry Decimal  @default(1500) @db.Decimal(12, 2)
  flatShippingFeeTry       Decimal  @default(99) @db.Decimal(12, 2)
  defaultTaxRate           Decimal  @default(0.2000) @db.Decimal(5, 4)
  eftDiscountRate          Decimal  @default(0) @db.Decimal(5, 4)
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("platform_settings")
}

// =============================================================================
// ADMIN AUDIT LOG — Tüm yüksek etkili admin işlemleri
// =============================================================================

// Audit log append-only'dir — güncelleme veya silme yapılmaz
model AdminAuditLog {
  id           String          @id @default(cuid())
  actorId      String // Admin kullanıcı ID
  actionType   AdminActionType
  targetType   String // 'order' | 'seller' | 'payout' | 'penalty' vb.
  targetId     String // Hedef kaydın ID'si
  previousData Json? // Değişiklik öncesi durum
  newData      Json? // Değişiklik sonrası durum
  reason       String? // Gerekçe (zorunlu olan action'larda)
  note         String? // Ek not
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([actionType, createdAt])
  @@map("admin_audit_logs")
}

// =============================================================================
// NOTIFICATION — Bildirimler
// =============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // Link veya ekstra context
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// PRODUCT REVIEW — Ürün değerlendirme + moderasyon
// =============================================================================
// Kural: Yalnızca ürünü satın alıp delivery_confirmed durumuna ulaşan müşteri
// değerlendirme yazabilir. Her sipariş için ürün başına tek değerlendirme.
// İçerik moderasyonundan geçmeyen yorum public sayfada görünmez.

model ProductReview {
  id             String              @id @default(cuid())
  productId      String
  customerId     String
  orderId        String
  rating         Int // 1-5 (DB constraint migration'da)
  title          String?             @db.VarChar(140)
  body           String              @db.Text
  status         ProductReviewStatus @default(pending_moderation)
  moderatedBy    String? // Admin user ID
  moderatedAt    DateTime?
  moderationNote String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  // One review per (order, product) pair
  @@unique([orderId, productId])
  // Listing for product page (only approved, sorted by createdAt desc)
  @@index([productId, status, createdAt])
  // Admin moderation queue (status filter)
  @@index([status, createdAt])
  @@map("product_reviews")
}

// =============================================================================
// COUPON — Kupon / İndirim Kodu
// =============================================================================

enum CouponDiscountType {
  percentage // Yüzde indirim (örn. %10)
  fixed_amount // Sabit tutar indirimi (örn. 50₺)
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(12, 2) // Oran (0-100) veya sabit tutar
  minCartTotal    Decimal?           @db.Decimal(12, 2) // Minimum sepet tutarı
  maxUsageTotal   Int? // Toplam kullanım limiti (null = sınırsız)
  maxUsagePerUser Int                @default(1) // Kullanıcı başına limit
  usageCount      Int                @default(0) // Mevcut kullanım sayısı
  isActive        Boolean            @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  usages CouponUsage[]

  @@index([code, isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique // Bir sipariş bir kupon kullanabilir
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}
