// Payout lifecycle — 07-marketplace-finance-rules.md
// Countdown: delivery_confirmed'dan 30 gün sonra
enum PayoutStatus {
  hold_active // 30 günlük bekletme dönemi aktif
  payout_blocked // İade/uyuşmazlık/fraud/admin hold nedeniyle bloke
  payout_ready // Tüm koşullar sağlandı, ödeme yapılabilir
  payout_scheduled // Toplu ödeme kuyruğuna alındı
  payout_paid // Ödeme gerçekleşti
}

enum PenaltyStatus {
  applied // Uygulandı, ledger'a yazıldı
  waived // Admin tarafından muaf tutuldu (gerekçeli)
  offset // Gelecek ödemeden mahsup edildi
}

enum PenaltyReason {
  seller_rejected_paid_order // Sat?c? onayl? sipari?i reddetti
  fulfillment_20day_breach // 20 g?nl?k teslimat y?k?ml?l??? ihlali
  late_shipment_daily_accrual // Sevk gecikmesinde g?nl?k %1 ceza birikimi
  other // Admin karar? ile di?er ceza
