// =============================================================================
// AUTH — Better Auth uyumlu
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  emailVerified      Boolean   @default(false)
  image              String?
  role               UserRole  @default(customer)
  // Better Auth two-factor plugin. Admin rollout starts in enrollment mode;
  // seller accounts are backfilled to require the email OTP factor.
  twoFactorEnabled   Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Better Auth ilişkileri
  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  // Domain ilişkileri
  seller                  Seller?
  addresses               Address[]
  cart                    Cart?
  orders                  Order[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  couponUsages            CouponUsage[]
  supportMessages         SupportMessage[]
  productReviews          ProductReview[]
  favorites               FavoriteProduct[]
  productAnalyticsEvents  ProductAnalyticsEvent[]
  followedStores          StoreFollow[]           @relation("StoreFollowUser")
  storeDiscountDispatches StoreDiscountDispatch[]
  paidPayouts             Payout[]                @relation("PayoutPaidByAdmin")
  createdSellerInvoices   SellerInvoice[]         @relation("SellerInvoiceCreatedByAdmin")
  marketingConsent        MarketingConsent?
  campaignEmailDispatches CampaignEmailDispatch[]

  customerSupportTickets         CustomerSupportTicket[]  @relation("CustomerSupportTicketsAsCustomer")
  resolvedCustomerSupportTickets CustomerSupportTicket[]  @relation("CustomerSupportTicketsAsResolver")
  customerSupportMessages        CustomerSupportMessage[] @relation("CustomerSupportMessageAuthor")

  extensionRequests FulfillmentExtensionRequest[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Better Auth two-factor plugin table. Admin TOTP secrets and backup codes are
// encrypted by Better Auth using BETTER_AUTH_SECRET. Seller rows are non-TOTP
// email-OTP markers. Never expose any of these values in responses or logs.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

// =============================================================================
// SELLER — Satıcı profili, banka bilgisi, finansal hesap
// =============================================================================

model Seller {
  id                     String       @id @default(cuid())
  userId                 String       @unique
  slug                   String       @unique // /magaza/<slug> SEO route'u
  displayName            String
  sellerNumber           Int          @unique @default(autoincrement())
  status                 SellerStatus @default(pending)
  vacationModeEnabled    Boolean      @default(false)
  commissionRateOverride Decimal?     @db.Decimal(5, 4)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  documentsRequestedAt   DateTime?
  requiredDocumentTypes  Json?
  importEnabled          Boolean      @default(false)
  importRequestedAt      DateTime?

  user                    User                          @relation(fields: [userId], references: [id])
  profile                 SellerProfile?
  bankDetails             SellerBankDetail[]
  bankDetailHistory       SellerBankDetailHistory[]
  documents               SellerDocument[]
  ledgerEntries           SellerLedgerEntry[]
  products                Product[]
  coupons                 Coupon[]
  discountRules           DiscountRule[]
  orderLines              OrderLine[]
  orderInvoices           OrderSellerInvoice[]
  orderEmailAliases       OrderEmailAlias[]
  shipments               Shipment[]
  payouts                 Payout[]
  penalties               Penalty[]
  sellerInvoices          SellerInvoice[]
  fulfillmentRisks        FulfillmentRisk[]
  followers               StoreFollow[]                 @relation("StoreFollowSeller")
  productAnalyticsEvents  ProductAnalyticsEvent[]
  storeDiscountDispatches StoreDiscountDispatch[]
  supportTickets          SupportTicket[]
  homeSlides              HomeSlide[]
  extensionRequests       FulfillmentExtensionRequest[]
  orderFulfillments       OrderSellerFulfillment[]

  @@index([status])
  @@index([slug])
  @@map("sellers")
}

model SellerProfile {
  id                     String    @id @default(cuid())
  sellerId               String    @unique
  bio                    String?
  story                  String?
  logoUrl                String?
  bannerUrl              String?
  bannerColor            String? // hex arka plan rengi, örn. "#2d1b69" — banner resmi yoksa kullanılır
  bannerHeadline         String? // banner üzerindeki özel metin (max 60 karakter)
  bannerTextColor        String? // başlık metin rengi hex, örn. "#ffffff"
  bannerHeadlineFontSize String? // "sm" | "md" | "lg" | "xl"
  companyName            String?
  city                   String?
  district               String?
  postalCode             String?
  legalAddress           String?
  phone                  String?
  taxOffice              String?
  taxNumber              String? // Vergi numarası (masked in non-admin views)
  mersis                 String?
  isVerified             Boolean   @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id])

  @@map("seller_profiles")
}

// Satıcı banka/IBAN bilgisi — kritik güvenlik alanı, her değişiklik loglanır
model SellerBankDetail {
  id                 String           @id @default(cuid())
  sellerId           String
  iban               String // Şifreli/masked saklanmalı — açık metne sadece payout akışında erişilir
  accountHolder      String
  bankName           String
  status             BankDetailStatus @default(PENDING_ACTIVATION)
  isActive           Boolean          @default(false) // Geciktirmeli aktivasyon — admin/sistem onayı gerekebilir
  isVerified         Boolean          @default(false)
  verifiedAt         DateTime?
  verifiedBy         String?
  activatedAt        DateTime?
  activatesAt        DateTime?
  stepUpVerifiedAt   DateTime?
  previousIbanMasked String?
  changeReason       String?
  blockedReason      String?
  blockedAt          DateTime?
  blockedBy          String?
  cancelledAt        DateTime?
  flags              Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller  Seller                    @relation(fields: [sellerId], references: [id])
  payouts Payout[]
  history SellerBankDetailHistory[]

  @@index([sellerId, isActive])
  @@index([sellerId, status, activatesAt])
  @@map("seller_bank_details")
}

model SellerBankDetailHistory {
  id                 String   @id @default(cuid())
  sellerId           String
  bankDetailId       String?
  action             String
  ibanMasked         String
  previousIbanMasked String?
  actorId            String
  actorRole          String
  ip                 String?
  userAgent          String?
  reason             String?
  createdAt          DateTime @default(now())

  seller     Seller            @relation(fields: [sellerId], references: [id])
  bankDetail SellerBankDetail? @relation(fields: [bankDetailId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@index([bankDetailId])
  @@map("seller_bank_detail_history")
}

// Satıcı KYC belgeleri — kimlik, vergi, sicil, imza belgesi vb.
// Her belge ayrı bir kayıt; aynı tipten birden fazla yükleme mümkün (son=geçerli).
model SellerDocument {
  id              String                      @id @default(cuid())
  sellerId        String
  type            SellerDocumentType
  identityPart    SellerDocumentIdentityPart? // Yalnızca identity türünde kullanılır
  uploadGroupId   String? // Sözleşme dosyalarını tek sürümde gruplar
  uploadOrder     Int? // Grup içindeki sıra (0 tabanlı)
  uploadGroupSize Int? // Gruptaki toplam dosya sayısı
  status          SellerDocumentStatus        @default(pending)
  fileUrl         String // Erişim işareti; KYC belgeleri için herkese açık URL değildir
  fileKey         String // Şifreli özel belge deposundaki anahtar
  fileName        String // Orijinal dosya adı (yalnızca bilgi amaçlı)
  mimeType        String // image/jpeg | image/png | application/pdf
  sizeBytes       Int
  adminNote       String? // Admin red/onay notu
  reviewedBy      String? // Admin kullanıcı ID
  reviewedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([sellerId, type])
  @@index([sellerId, type, identityPart])
  @@index([sellerId, type, uploadGroupId])
  @@index([status])
  @@map("seller_documents")
}

// Satıcı finansal ledger'ı — her finansal hareket buraya kayıt edilir
// Her kayıt immutable: üzerine yazma yok, yalnızca yeni kayıt eklenir
model SellerLedgerEntry {
  id              String          @id @default(cuid())
  sellerId        String
  type            LedgerEntryType
  amount          Decimal         @db.Decimal(12, 2) // Pozitif = giriş, negatif = çıkış
  balanceAfter    Decimal         @db.Decimal(12, 2) // Bu kayıt sonrası güncel bakiye
  eventKey        String?         @unique // Aynı finansal olayın yeniden uygulanmasını engeller
  referenceType   String // 'order' | 'payout' | 'penalty' | 'manual' vb.
  referenceId     String // İlgili kaydın ID'si
  description     String? // İnsan okunabilir açıklama
  visibleToSeller Boolean         @default(false) // Accrual entries hidden until invoice is issued; payout entries marked visible explicitly
  effectiveAt     DateTime        @default(now()) // Finansal olay zamanı; createdAt append/audit zamanıdır
  createdAt       DateTime        @default(now())
  createdBy       String? // Admin action'dan geliyorsa actor ID

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([sellerId, effectiveAt])
  @@index([sellerId, visibleToSeller, createdAt])
  @@index([sellerId, visibleToSeller, effectiveAt])
  @@index([referenceType, referenceId])
  @@map("seller_ledger_entries")
}

// =============================================================================
// CATALOG — Kategori, Ürün, Görsel, Varyant
// =============================================================================

model Category {
  id                 String    @id @default(cuid())
  slug               String    @unique // /kategori/<slug>
  name               String
  description        String?
  imageUrl           String?
  parentId           String?
  sortOrder          Int       @default(0)
  isActive           Boolean   @default(true)
  taxRate            Decimal?  @db.Decimal(5, 4) // KDV oranı; boşsa üst kategori / platform varsayılanı kullanılır
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdViaImportBy String? // Seller.id — import commit ile açıldıysa; null = admin/seed
  createdViaImportAt DateTime? // Import commit zamanı

  parent           Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]                @relation("CategoryTree")
  products         Product[]
  discountRules    DiscountRule[]
  attributeOptions CategoryAttributeOption[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  sellerId         String
  categoryId       String?
  slug             String        @unique // /urun/<slug>
  name             String
  description      String?
  shortDescription String?
  story            String? // Ürün Hikayesi
  careInstructions String? // Bakım Tavsiyesi
  status           ProductStatus @default(draft)
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  fulfillmentDays  Int           @default(20)
  stockQuantity    Int           @default(0)
  sku              String?
  modelCode        String        @default(dbgenerated("'LEGACY-' || gen_random_uuid()::text")) @db.VarChar(120)
  barcode          String?       @unique @db.VarChar(13)
  weight           Decimal?      @db.Decimal(8, 3) // kg
  // Boyutlar (cm)
  dimensionLength  Decimal?      @db.Decimal(8, 2)
  dimensionWidth   Decimal?      @db.Decimal(8, 2)
  dimensionHeight  Decimal?      @db.Decimal(8, 2)

  // Aggregate review fields — recomputed on review approve/reject
  avgRating   Decimal? @db.Decimal(3, 2) // 0.00 — 5.00
  reviewCount Int      @default(0)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  publishedAt        DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  moderationFindings Json?

  seller               Seller                  @relation(fields: [sellerId], references: [id])
  category             Category?               @relation(fields: [categoryId], references: [id])
  discountRuleProducts DiscountRuleProduct[]
  images               ProductImage[]
  variants             ProductVariant[]
  attributeValues      ProductAttributeValue[]
  orderLines           OrderLine[]
  reviews              ProductReview[]
  favoritedBy          FavoriteProduct[]
  analyticsEvents      ProductAnalyticsEvent[]
  barcodeReservation   BarcodeRegistry?        @relation("ProductBarcodeRegistry")

  @@index([sellerId, status])
  @@index([barcode])
  @@index([categoryId, status])
  @@index([slug])
  @@index([sellerId, sku])
  @@index([sellerId, categoryId, modelCode])
  @@map("products")
}

model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorite_products")
}

model ProductAnalyticsEvent {
  id        String                    @id @default(cuid())
  productId String
  sellerId  String
  userId    String
  eventType ProductAnalyticsEventType
  eventDate DateTime                  @db.Date
  createdAt DateTime                  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId, eventType, eventDate])
  @@index([sellerId, eventType, eventDate])
  @@index([sellerId, createdAt])
  @@index([productId, eventType, eventDate])
  @@map("product_analytics_events")
}

model StoreFollow {
  id               String    @id @default(cuid())
  userId           String
  sellerId         String
  emailOptOutAt    DateTime?
  emailOptOutToken String    @unique
  createdAt        DateTime  @default(now())

  user   User   @relation("StoreFollowUser", fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation("StoreFollowSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerId])
  @@index([sellerId, createdAt])
  @@map("store_follows")
}

model DiscountRule {
  id         String            @id @default(cuid())
  sellerId   String
  name       String
  scope      DiscountRuleScope
  type       DiscountType
  value      Decimal           @db.Decimal(10, 2)
  categoryId String?
  status     DiscountStatus    @default(ACTIVE)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  seller   Seller                @relation(fields: [sellerId], references: [id])
  category Category?             @relation(fields: [categoryId], references: [id])
  products DiscountRuleProduct[]

  @@index([sellerId, status])
  @@index([categoryId])
  @@map("discount_rules")
}

model DiscountRuleProduct {
  discountRuleId String
  productId      String

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountRuleId, productId])
  @@index([productId])
  @@map("discount_rule_products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String // Örn: "Renk: Krem / Beden: L"
  sku           String?
  barcode       String   @unique @db.VarChar(13)
  price         Decimal? @db.Decimal(12, 2) // null ise ürün fiyatı geçerli
  stockQuantity Int      @default(0)
  options       Json // { "Renk": "Krem", "Beden": "L" }
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodeReservation BarcodeRegistry? @relation("VariantBarcodeRegistry")

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model BarcodeRegistry {
  barcode   String   @id @db.VarChar(13)
  productId String?  @unique
  variantId String?  @unique
  createdAt DateTime @default(now())

  product Product?        @relation("ProductBarcodeRegistry", fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation("VariantBarcodeRegistry", fields: [variantId], references: [id], onDelete: Cascade)

  @@map("barcode_registry")
}

// =============================================================================
// CART — Sepet
// =============================================================================

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  sessionId  String?  @unique // Guest cart
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // Sepete eklendiği andaki fiyat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// =============================================================================
// ADDRESS — Adres
// =============================================================================

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String? // "Ev", "İş"
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  district     String
  city         String
  postalCode   String
  country      String  @default("TR")
  isDefault    Boolean @default(false)

  // Fatura adresi alanları
  isBillingAddress  Boolean      @default(false)
  invoiceType       InvoiceType?
  tcNumber          String?
  isForeignNational Boolean      @default(false)
  companyName       String?
  taxOffice         String?
  taxNumber         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id])
  orders        Order[] @relation("OrderDeliveryAddress")
  billingOrders Order[] @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

// =============================================================================
// ORDER — Sipariş lifecycle
// =============================================================================

model Order {
  id                       String                   @id @default(cuid())
  publicNumber             Int                      @unique @default(autoincrement())
  customerId               String
  addressId                String?
  billingAddressId         String?
  status                   OrderStatus              @default(draft)
  currency                 String                   @default("TRY")
  cancellationReason       OrderCancellationReason?
  quantityLifecycleVersion Int                      @default(1)

  // Finansal alanlar — ayrı ayrı tutulur (vague toplam yok)
  grossAmount             Decimal  @db.Decimal(12, 2) // Sepet toplam?
  netSubtotal             Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal  @default(0) @db.Decimal(12, 2)
  shippingAmount          Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal  @default(0) @db.Decimal(12, 2) // ?r?n fiyatlar?na dahil KDV tutar?
  taxBreakdownJson        Json?
  eftDiscountAmount       Decimal  @default(0) @db.Decimal(12, 2)
  eftDiscountRateSnapshot Decimal? @db.Decimal(5, 4)
  totalAmount             Decimal  @db.Decimal(12, 2) // M??terinin ?dedi?i tutar
  refundedShippingAmount  Decimal  @default(0) @db.Decimal(12, 2)

  couponCode String?
  notes      String?

  // Önemli zaman damgaları
  paymentConfirmedAt  DateTime?
  sellerQueueReadyAt  DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  deliveryConfirmedAt DateTime? // Payout countdown bu tarihten başlar
  cancelledAt         DateTime?
  refundCompletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer               User                          @relation(fields: [customerId], references: [id])
  address                Address?                      @relation("OrderDeliveryAddress", fields: [addressId], references: [id])
  billingAddress         Address?                      @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  lines                  OrderLine[]
  payments               Payment[]
  shipments              Shipment[]
  statusHistory          OrderStatusHistory[]
  legalSnapshot          OrderLegalSnapshot?
  sellerInvoices         OrderSellerInvoice[]
  emailAliases           OrderEmailAlias[]
  inboundEmails          InboundEmail[]
  payouts                Payout[]
  penalties              Penalty[]
  financeInvoices        SellerInvoice[]               @relation("SellerInvoiceOrder")
  fulfillmentRisks       FulfillmentRisk[]
  returnRequests         ReturnRequest[]
  disputes               Dispute[]
  couponUsage            CouponUsage?
  supportTickets         SupportTicket[]
  productReviews         ProductReview[]
  customerSupportTickets CustomerSupportTicket[]       @relation("OrderCustomerSupportTickets")
  extensionRequests      FulfillmentExtensionRequest[]
  sellerFulfillments     OrderSellerFulfillment[]
  cancellations          OrderCancellation[]
  refundTransactions     RefundTransaction[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([publicNumber])
  @@map("orders")
}

model OrderLegalSnapshot {
  id                       String    @id @default(cuid())
  orderId                  String    @unique
  distanceSalesHtml        String    @db.Text
  preInformationHtml       String    @db.Text
  distanceSalesVersion     String?
  preInformationVersion    String?
  distanceSalesHash        String?
  preInformationHash       String?
  acceptedDistanceSalesAt  DateTime?
  acceptedPreInformationAt DateTime?
  acceptedIp               String?
  acceptedUserAgent        String?   @db.Text
  acceptedSessionId        String?
  buyerSnapshot            Json
  sellerSnapshot           Json
  platformSnapshot         Json
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_legal_snapshots")
}

model OrderSellerInvoice {
  id             String   @id @default(cuid())
  orderId        String
  sellerId       String
  inboundEmailId String?  @unique
  fileUrl        String
  fileKey        String
  fileName       String
  mimeType       String
  sizeBytes      Int
  source         String   @default("manual")
  uploadedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller       Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inboundEmail InboundEmail? @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)

  @@unique([orderId, sellerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([source])
  @@map("order_seller_invoices")
}

model OrderEmailAlias {
  id            String    @id @default(cuid())
  orderId       String
  sellerId      String
  aliasEmail    String    @unique
  localPart     String    @unique
  purpose       String    @default("invoice")
  status        String    @default("active")
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([orderId, sellerId, purpose])
  @@index([sellerId, status])
  @@index([orderId])
  @@map("order_email_aliases")
}

model InboundEmail {
  id                 String   @id @default(cuid())
  messageId          String   @unique
  orderId            String?
  sellerId           String?
  aliasEmail         String
  fromEmail          String?
  subject            String?
  status             String
  selectedAttachment Json?
  errorReason        String?
  receivedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order   Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice OrderSellerInvoice?

  @@index([aliasEmail])
  @@index([orderId])
  @@index([status])
  @@map("inbound_emails")
}

model OrderLine {
  id                        String   @id @default(cuid())
  orderId                   String
  productId                 String
  sellerId                  String
  variantId                 String?
  productName               String // Sipariş anındaki ürün adı snapshot
  variantName               String? // Sipariş anındaki varyant snapshot
  quantity                  Int
  cancelledQuantity         Int      @default(0)
  shippedQuantity           Int      @default(0)
  returnClaimedQuantity     Int      @default(0)
  unitPrice                 Decimal  @db.Decimal(12, 2) // Sipariş anındaki fiyat snapshot
  totalPrice                Decimal  @db.Decimal(12, 2)
  customerPaidProductAmount Decimal? @db.Decimal(12, 2)
  taxRate                   Decimal  @default(0) @db.Decimal(5, 4)
  taxAmount                 Decimal  @default(0) @db.Decimal(12, 2) // Satır toplamına dahil KDV
  // Satır bazında satıcı kuponu payı snapshot'ı — Order.discountAmount'ın bu satıra
  // düşen dağıtımı. Yalnız satıcı kuponunda (Coupon.sellerId dolu) > 0 olur; platform
  // kuponunda 0 kalır (platform emer). Komisyon tabanını ve net hakedişi düşürür.
  couponDiscountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  // Satıcı payout hesabı için
  commissionRate            Decimal  @default(0) @db.Decimal(5, 4) // Örn: 0.1500 = %15
  commissionAmount          Decimal  @default(0) @db.Decimal(12, 2)
  netPayoutAmount           Decimal  @default(0) @db.Decimal(12, 2)

  // Komisyon muafiyeti (admin kararı ile)
  commissionExemptedAt     DateTime?
  commissionExemptedBy     String? // Admin User.id
  commissionExemptedReason String?
  commissionInvoiceId      String? // Hangi SellerInvoice'a bağlandığı (FK)
  promisedFulfillmentDays  Int? // Sipariş anındaki sevk süresi snapshot (iş günü)
  fulfillmentDueAt         DateTime?
  fulfilledAt              DateTime?

  // Per-satır teslimat onayı — order.deliveryConfirmedAt ile eş zamanlı yazılır
  deliveryConfirmedAt DateTime?
  deliveryConfirmedBy String? // 'customer' | 'admin_<id>' | 'system'

  createdAt DateTime @default(now())

  order                  Order                   @relation(fields: [orderId], references: [id])
  product                Product                 @relation(fields: [productId], references: [id])
  seller                 Seller                  @relation(fields: [sellerId], references: [id])
  fulfillmentRisk        FulfillmentRisk?
  payout                 Payout?
  commissionInvoice      SellerInvoice?          @relation("OrderLineCommissionInvoice", fields: [commissionInvoiceId], references: [id], onDelete: SetNull)
  penalties              Penalty[]
  cancellationItems      OrderCancellationItem[]
  returnItems            ReturnRequestItem[]
  shipmentItems          ShipmentItem[]
  paymentProviderItems   PaymentProviderItem[]
  refundTransactionItems RefundTransactionItem[]

  @@index([orderId])
  @@index([sellerId])
  @@index([commissionInvoiceId])
  @@map("order_lines")
}

// Seller requests an extra fulfillment window when the 20-business-day deadline
// is approaching. Three-way flow: seller → admin → (optional) customer.
// IP / UA / session snapshot on customer response provides legal evidence.
model FulfillmentExtensionRequest {
  id         String @id @default(cuid())
  orderId    String
  sellerId   String
  customerId String

  requestedDays Int
  sellerReason  String

  status ExtensionRequestStatus @default(pending_admin_review)

  adminNote       String?
  adminReviewedAt DateTime?
  adminReviewedBy String? // Admin User.id

  // Admin → customer question, customer answer (with legal evidence)
  customerQuestionFromAdmin String?
  customerResponseNote      String?
  customerRespondedAt       DateTime?
  customerResponseIp        String?
  customerResponseUserAgent String?
  customerResponseSessionId String?

  // Final approved extension window
  approvedDays Int?
  approvedAt   DateTime?
  approvedBy   String? // Admin User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller   Seller @relation(fields: [sellerId], references: [id])
  customer User   @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
  @@index([sellerId, status])
  @@map("fulfillment_extension_requests")
}

model FulfillmentRisk {
  id               String                @id @default(cuid())
  orderId          String
  orderLineId      String?               @unique
  sellerId         String
  status           FulfillmentRiskStatus
  deadlineAt       DateTime
  warningStartedAt DateTime?
  breachedAt       DateTime?
  resolvedAt       DateTime?
  lastSeenAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sellerId, status])
  @@index([status, deadlineAt])
  @@map("fulfillment_risks")
}

// Sipariş durum geçmişi — append-only, üzerine yazma yok
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String? // Değişikliği yapan kullanıcı ID'si
  actorRole  UserRole?
  reason     String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// =============================================================================
// PAYMENT — Ödeme
// =============================================================================

model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  method                PaymentMethod
  provider              PaymentProvider
  status                PaymentStatus   @default(pending)
  currency              String          @default("TRY")
  amount                Decimal         @db.Decimal(12, 2)
  // Iyzico entegrasyon alanları
  providerPaymentId     String?         @unique // Iyzico payment ID — bir provider ödemesi yalnız bir siparişi onaylayabilir
  providerReferenceId   String?
  providerData          Json? // Raw provider response (audit için)
  // EFT/Havale için
  eftSenderName         String?
  eftConfirmedBy        String? // Admin actor ID
  eftConfirmedAt        DateTime?
  eftRejectedBy         String?
  eftRejectedAt         DateTime?
  eftRejectionReason    String?
  eftDiscountAmount     Decimal?        @db.Decimal(12, 2) // Admin tarafından uygulanan indirim tutarı
  eftDiscountReason     String? // İndirim gerekçesi
  selectedBankAccountId String? // Müşterinin havale yapacağı banka hesabı (snapshot için)
  // Timing
  confirmedAt           DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?
  refundedAmount        Decimal         @default(0) @db.Decimal(12, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order               Order                 @relation(fields: [orderId], references: [id])
  events              PaymentEvent[]
  selectedBankAccount PlatformBankAccount?  @relation(fields: [selectedBankAccountId], references: [id])
  refundTransactions  RefundTransaction[]
  providerItems       PaymentProviderItem[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentProviderItem {
  id                    String                  @id @default(cuid())
  paymentId             String
  orderLineId           String?
  kind                  PaymentProviderItemKind
  providerItemId        String
  providerTransactionId String?
  amount                Decimal                 @db.Decimal(12, 2)
  refundedAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  providerData          Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  payment     Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderLine   OrderLine?              @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  refundItems RefundTransactionItem[]

  @@unique([paymentId, providerItemId])
  @@unique([paymentId, orderLineId])
  @@index([providerTransactionId])
  @@map("payment_provider_items")
}

// Ödeme olayları — webhook, callback, manuel değişiklikler
model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  eventType   String // 'webhook_received' | 'status_changed' | 'refund_initiated' vb.
  payload     Json? // Orijinal event verisi
  processedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

// =============================================================================
// SHIPMENT — Kargo
// =============================================================================

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String
  sellerId            String
  cargoProvider       String // "yurtiçi" | "aras" | "ptt" | "mng" | "sürat"
  trackingNumber      String?
  status              ShipmentStatus @default(preparing)
  handedAt            DateTime? // Kargoya teslim edildiği an
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id])
  seller Seller          @relation(fields: [sellerId], references: [id])
  events ShipmentEvent[]
  items  ShipmentItem[]

  @@unique([orderId, sellerId])
  @@index([sellerId])
  @@map("shipments")
}

// Kargo durum olayları — kargo entegrasyonu veya manuel güncelleme
model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String?
  source      String         @default("manual") // 'cargo_integration' | 'manual' | 'admin'
  occurredAt  DateTime
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipment_events")
}

// =============================================================================
// PAYOUT — Satıcı ödemesi
// =============================================================================

// Her OrderLine için ayrı Payout kaydı olabilir veya tek Order için tek Payout.
// Bu implementasyonda Order bazlı Payout kullanıyoruz.
// Countdown başlangıcı: order.deliveryConfirmedAt + 30 gün
model Payout {
  id           String       @id @default(cuid())
  sellerId     String
  orderId      String
  orderLineId  String?      @unique
  bankDetailId String?
  status       PayoutStatus @default(hold_active)
  currency     String       @default("TRY")

  // Payout hesabı — 07-marketplace-finance-rules.md net_payout formula
  grossAmount       Decimal @db.Decimal(12, 2)
  commissionAmount  Decimal @default(0) @db.Decimal(12, 2)
  couponShareAmount Decimal @default(0) @db.Decimal(12, 2)
  cargoChargeAmount Decimal @default(0) @db.Decimal(12, 2)
  adFeeAmount       Decimal @default(0) @db.Decimal(12, 2)
  penaltyAmount     Decimal @default(0) @db.Decimal(12, 2)
  refundAmount      Decimal @default(0) @db.Decimal(12, 2)
  adjustmentAmount  Decimal @default(0) @db.Decimal(12, 2) // Manuel düzeltme
  netAmount         Decimal @db.Decimal(12, 2) // Nihai ödeme tutarı

  // Hold period
  holdStartedAt DateTime? // deliveryConfirmedAt ile aynı
  holdUntil     DateTime? // holdStartedAt + 30 gün
  blockedReason String? // Neden bloke — görünür olmalı

  batchId               String? // PayoutBatch ilişkisi
  paidAt                DateTime?
  transferReference     String?
  transferDate          DateTime?
  transferBankName      String?
  transferNote          String?
  paidByAdminId         String?
  ibanSnapshot          String?
  accountHolderSnapshot String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  seller          Seller            @relation(fields: [sellerId], references: [id])
  order           Order             @relation(fields: [orderId], references: [id])
  orderLine       OrderLine?        @relation(fields: [orderLineId], references: [id])
  bankDetail      SellerBankDetail? @relation(fields: [bankDetailId], references: [id])
  batch           PayoutBatch?      @relation(fields: [batchId], references: [id])
  paidByAdmin     User?             @relation("PayoutPaidByAdmin", fields: [paidByAdminId], references: [id])
  financeInvoices SellerInvoice[]   @relation("SellerInvoicePayout")

  @@index([sellerId, status])
  @@index([orderId])
  @@index([holdUntil, status])
  @@index([paidByAdminId])
  @@map("payouts")
}

// Toplu ödeme partisi
model PayoutBatch {
  id          String    @id @default(cuid())
  reference   String    @unique // İnsan okunabilir referans kodu
  totalAmount Decimal   @db.Decimal(14, 2)
  sellerCount Int       @default(0)
  payoutCount Int       @default(0)
  processedBy String? // Admin actor ID
  processedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  payouts Payout[]

  @@map("payout_batches")
}

// =============================================================================
// PENALTY — Ceza
// =============================================================================

// Standart ceza oranı: %20 (CLAUDE.md 2.4)
model Penalty {
  id                String        @id @default(cuid())
  sellerId          String
  orderId           String
  orderLineId       String?
  reason            PenaltyReason
  status            PenaltyStatus @default(applied)
  baseAmount        Decimal       @db.Decimal(12, 2) // Ürün fiyatı
  rate              Decimal       @default(0.2000) @db.Decimal(5, 4) // %20
  penaltyAmount     Decimal       @db.Decimal(12, 2) // baseAmount * rate
  // Muafiyet
  waivedBy          String? // Admin actor ID
  waivedAt          DateTime?
  waiverReason      String?
  // Mahsup
  offsetPayoutId    String? // Hangi payout'tan mahsup edildi
  accrualSourceDate DateTime?
  accrualDayCount   Int?
  dailyAccrualRate  Decimal?      @default(0.0100) @db.Decimal(5, 4)
  lastAccrualAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller          Seller          @relation(fields: [sellerId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id])
  orderLine       OrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  financeInvoices SellerInvoice[] @relation("SellerInvoicePenalty")

  @@index([sellerId, status])
  @@index([orderId])
  @@index([orderLineId])
  @@map("penalties")
}

model SellerInvoice {
  id                 String            @id @default(cuid())
  sellerId           String
  type               SellerInvoiceType
  invoiceNumber      String            @unique
  invoiceDate        DateTime
  invoiceCategory    String?
  description        String?
  amount             Decimal           @db.Decimal(12, 2) // Net tutar (KDV hariç)
  vatRate            Decimal           @default(0) @db.Decimal(5, 4) // Komisyon faturası: 0.20, ceza faturası: 0.00
  vatAmount          Decimal           @default(0) @db.Decimal(12, 2)
  grossInvoiceAmount Decimal           @db.Decimal(12, 2) // amount + vatAmount
  sourceOrderId      String?
  sourcePenaltyId    String?
  payoutId           String?
  createdByAdminId   String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  seller         Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sourceOrder    Order?      @relation("SellerInvoiceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourcePenalty  Penalty?    @relation("SellerInvoicePenalty", fields: [sourcePenaltyId], references: [id], onDelete: SetNull)
  payout         Payout?     @relation("SellerInvoicePayout", fields: [payoutId], references: [id], onDelete: SetNull)
  createdByAdmin User        @relation("SellerInvoiceCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  orderLines     OrderLine[] @relation("OrderLineCommissionInvoice")

  @@index([sellerId, type])
  @@index([sourceOrderId])
  @@index([sourcePenaltyId])
  @@index([payoutId])
  @@index([createdByAdminId])
  @@map("seller_invoices")
}

// =============================================================================
// RETURN & DISPUTE — İade ve Uyuşmazlık
// =============================================================================

model ReturnRequest {
  id                        String              @id @default(cuid())
  orderId                   String
  customerId                String
  sellerId                  String?
  requestKey                String?
  status                    ReturnRequestStatus @default(requested)
  reason                    String
  description               String?
  isWithinWindow            Boolean // 14 günlük cayma hakkı içinde mi
  // Satıcı iade kargo talimatı (satıcı → müşteri)
  sellerReturnAddress       String?
  sellerReturnCargoCarrier  String?
  sellerReturnInstructions  String?
  sellerCargoInfoProvidedAt DateTime?
  // Müşteri iade kargo bilgisi (müşteri → satıcı)
  returnTrackingNumber      String?
  returnCargoProvider       String?
  customerShippedAt         DateTime?
  // Satıcı teslim aldığında onay/red
  sellerReceivedAt          DateTime?
  sellerRejectReason        String?
  sellerRejectDescription   String?
  sellerRejectedAt          DateTime?
  // Çözüm (admin override yolu)
  reviewedBy                String? // Admin actor ID
  reviewedAt                DateTime?
  reviewNote                String?
  itemReceivedAt            DateTime?
  // Finansal etki
  refundAmount              Decimal?            @db.Decimal(12, 2)
  refundedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order            Order               @relation(fields: [orderId], references: [id])
  messages         ReturnMessage[]
  // Satıcı reddi sonrası eskale edilen uyuşmazlık (1-1)
  disputeId        String?             @unique
  escalatedDispute Dispute?            @relation("ReturnEscalation", fields: [disputeId], references: [id])
  evidence         MediaAsset[]
  items            ReturnRequestItem[]

  @@unique([orderId, customerId, requestKey, sellerId])
  @@index([orderId])
  @@index([customerId])
  @@index([sellerId, status])
  @@index([disputeId])
  @@map("return_requests")
}

model OrderSellerFulfillment {
  id                  String                  @id @default(cuid())
  orderId             String
  sellerId            String
  status              SellerFulfillmentStatus @default(queue_ready)
  acceptedAt          DateTime?
  preparingAt         DateTime?
  awaitingShipmentAt  DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  deliveryConfirmedAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@map("order_seller_fulfillments")
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderLineId String
  quantity    Int
  createdAt   DateTime @default(now())

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderLineId])
  @@index([orderLineId])
  @@map("shipment_items")
}

model OrderCancellation {
  id                         String                  @id @default(cuid())
  orderId                    String
  sellerId                   String
  customerId                 String
  requestKey                 String?
  reason                     String
  status                     OrderCancellationStatus @default(refund_pending)
  customerRefundAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  grossProductAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  couponAdjustmentAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  sellerAdjustmentAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  commissionAdjustmentAmount Decimal                 @default(0) @db.Decimal(12, 2)
  shippingRefundAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  order Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderCancellationItem[]

  @@unique([orderId, customerId, requestKey, sellerId])
  @@index([orderId, createdAt])
  @@index([sellerId, status])
  @@map("order_cancellations")
}

model OrderCancellationItem {
  id                         String   @id @default(cuid())
  cancellationId             String
  orderLineId                String
  quantity                   Int
  customerRefundAmount       Decimal  @db.Decimal(12, 2)
  grossProductAmount         Decimal  @default(0) @db.Decimal(12, 2)
  couponAdjustmentAmount     Decimal  @default(0) @db.Decimal(12, 2)
  sellerAdjustmentAmount     Decimal  @db.Decimal(12, 2)
  commissionAdjustmentAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt                  DateTime @default(now())

  cancellation OrderCancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  orderLine    OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([cancellationId, orderLineId])
  @@index([orderLineId])
  @@map("order_cancellation_items")
}

model ReturnRequestItem {
  id                                  String   @id @default(cuid())
  returnRequestId                     String
  orderLineId                         String
  requestedQuantity                   Int
  acceptedQuantity                    Int      @default(0)
  rejectedQuantity                    Int      @default(0)
  rejectionReason                     String?
  requestedCustomerAmount             Decimal  @default(0) @db.Decimal(12, 2)
  requestedGrossProductAmount         Decimal  @default(0) @db.Decimal(12, 2)
  requestedCouponAdjustmentAmount     Decimal  @default(0) @db.Decimal(12, 2)
  requestedSellerAdjustmentAmount     Decimal  @default(0) @db.Decimal(12, 2)
  requestedCommissionAdjustmentAmount Decimal  @default(0) @db.Decimal(12, 2)
  customerRefundAmount                Decimal  @default(0) @db.Decimal(12, 2)
  grossProductAmount                  Decimal  @default(0) @db.Decimal(12, 2)
  couponAdjustmentAmount              Decimal  @default(0) @db.Decimal(12, 2)
  sellerAdjustmentAmount              Decimal  @default(0) @db.Decimal(12, 2)
  commissionAdjustmentAmount          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderLine     OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderLineId])
  @@index([orderLineId])
  @@map("return_request_items")
}

model RefundTransaction {
  id                         String                  @id @default(cuid())
  orderId                    String
  paymentId                  String?
  sellerId                   String?
  sourceType                 RefundSourceType
  sourceId                   String
  customerAmount             Decimal                 @db.Decimal(12, 2)
  grossProductAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  couponAdjustmentAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  sellerAdjustmentAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  commissionAdjustmentAmount Decimal                 @default(0) @db.Decimal(12, 2)
  platformFundedAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  status                     RefundTransactionStatus @default(pending)
  providerReference          String?
  failureReason              String?
  accountingAppliedAt        DateTime?
  ledgerAppliedAt            DateTime?
  payoutAppliedAt            DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  order   Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items   RefundTransactionItem[]

  @@unique([sourceType, sourceId])
  @@index([status, createdAt])
  @@index([orderId, sellerId])
  @@map("refund_transactions")
}

model RefundTransactionItem {
  id                    String                      @id @default(cuid())
  refundTransactionId   String
  paymentProviderItemId String?
  orderLineId           String?
  kind                  PaymentProviderItemKind
  amount                Decimal                     @db.Decimal(12, 2)
  quantity              Int?
  status                RefundTransactionItemStatus @default(pending)
  providerReference     String?
  failureReason         String?
  attemptCount          Int                         @default(0)
  lastAttemptAt         DateTime?
  completedAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  refundTransaction   RefundTransaction    @relation(fields: [refundTransactionId], references: [id], onDelete: Cascade)
  paymentProviderItem PaymentProviderItem? @relation(fields: [paymentProviderItemId], references: [id], onDelete: SetNull)
  orderLine           OrderLine?           @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([refundTransactionId, paymentProviderItemId], map: "refund_tx_items_refund_provider_item_key")
  @@unique([refundTransactionId, orderLineId, kind], map: "refund_tx_items_refund_order_line_kind_key")
  @@index([status, createdAt])
  @@map("refund_transaction_items")
}

model ReturnMessage {
  id              String   @id @default(cuid())
  returnRequestId String
  authorId        String
  authorRole      UserRole
  body            String
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  attachments   MediaAsset[]

  @@index([returnRequestId])
  @@map("return_messages")
}

model Dispute {
  id            String        @id @default(cuid())
  orderId       String
  openedById    String
  status        DisputeStatus @default(open)
  reason        String
  description   String?
  // Çözüm
  resolvedBy    String? // Admin actor ID
  resolvedAt    DateTime?
  resolution    String?
  // Finansal etki
  payoutBlocked Boolean       @default(true)
  refundAmount  Decimal?      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order               Order            @relation(fields: [orderId], references: [id])
  messages            DisputeMessage[]
  evidence            MediaAsset[]
  // Satıcı iade reddinden eskale edildiyse ilgili iade talebi (1-1)
  escalatedFromReturn ReturnRequest?   @relation("ReturnEscalation")

  @@index([orderId])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  authorId   String
  authorRole UserRole
  body       String
  createdAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

// =============================================================================
// CONTENT — Blog, Sayfa
// =============================================================================

model BlogPost {
  id                 String         @id @default(cuid())
  slug               String         @unique // /blog/<slug>
  title              String
  summary            String?
  body               String
  coverUrl           String?
  status             BlogPostStatus @default(draft)
  authorId           String
  rootTopic          String?
  subIntent          String?
  intentType         String?
  targetKeyword      String?
  supportingKeywords Json?
  linkedCategoryIds  Json?
  linkedProductIds   Json?
  clusterKey         String?
  qualityScore       Int?
  generationMetadata Json?
  generatedBy        String?
  generatedAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([clusterKey])
  @@index([rootTopic, intentType])
  @@map("blog_posts")
}

model SeoContentRun {
  id             String    @id @default(cuid())
  mode           String
  status         String
  triggeredBy    String?
  budgetSnapshot Json?
  totals         Json?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  generations SeoContentGeneration[]

  @@index([status, startedAt])
  @@index([mode, createdAt])
  @@map("seo_content_runs")
}

model SeoContentGeneration {
  id                    String   @id @default(cuid())
  runId                 String
  clusterKey            String
  idempotencyKey        String?  @unique
  status                String
  candidateSnapshot     Json
  factPackHash          String?
  promptVersion         String?
  schemaVersion         String?
  promptHash            String?
  openaiResponseId      String?
  openaiImageResponseId String?
  tokenUsage            Json?
  estimatedCostUsd      Float?
  imageAssetId          String?
  imageObjectKey        String?
  gateResults           Json?
  errors                Json?
  blogPostId            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  run SeoContentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([clusterKey, createdAt])
  @@map("seo_content_generations")
}

model SiteSearchQuery {
  id              String   @id @default(cuid())
  query           String
  normalizedQuery String
  categorySlug    String?
  resultCount     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([normalizedQuery, createdAt])
  @@index([categorySlug, createdAt])
  @@map("site_search_queries")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // /sayfa/<slug>
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// =============================================================================
// HOME CMS — Ana sayfa hero slider ve promo kartlar
// Admin paneli /admin/anasayfa üzerinden yönetilir.
// Storefront 5 dakika cache kullanır (revalidate: 300).
// =============================================================================

// Ana sayfa hero slider slaytları — N slayt destekler
model HomeSlide {
  id String @id @default(cuid())

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // Medya — görsel veya video (MediaAsset.kind = image | video)
  mediaAssetId String
  mediaAsset   MediaAsset @relation("HomeSlideMedia", fields: [mediaAssetId], references: [id])

  // Video ise poster (autoplay öncesi ve düşük bant genişliğinde fallback — zorunlu)
  posterAssetId String?
  posterAsset   MediaAsset? @relation("HomeSlidePoster", fields: [posterAssetId], references: [id])

  // İçerik
  eyebrow  String? @db.VarChar(60) // "YENİ KOLEKSİYON" / "%30 İNDİRİM"
  title    String  @db.VarChar(120)
  body     String? @db.VarChar(300)
  ctaLabel String  @db.VarChar(40)
  ctaHref  String  @db.VarChar(500)

  // Zamanlama penceresi — null = hep aktif
  startsAt DateTime?
  endsAt   DateTime?

  // İsteğe bağlı satıcı ataması (kampanya analytics için)
  sellerId String?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // Admin User.id

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@index([sellerId])
  @@map("home_slides")
}

// Ana sayfa sağ sütun promo kartları — sabit 2 slot
model HomePromo {
  id   String        @id @default(cuid())
  slot HomePromoSlot @unique // Her slot için tek aktif kayıt

  isActive Boolean @default(true)

  // Sadece görsel — videoya izin yok
  mediaAssetId String
  mediaAsset   MediaAsset @relation("HomePromoMedia", fields: [mediaAssetId], references: [id])

  title    String  @db.VarChar(80)
  subtitle String? @db.VarChar(160)
  ctaHref  String  @db.VarChar(500)

  // Zamanlama penceresi — null = hep aktif
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // Admin User.id

  @@index([slot, isActive])
  @@map("home_promos")
}

// =============================================================================
// MEDIA ASSET — Medya dosyaları (Cloudflare R2)
// =============================================================================

model MediaAsset {
  id              String         @id @default(cuid())
  type            MediaAssetType
  kind            MediaAssetKind @default(image)
  url             String // R2 CDN public URL
  key             String? // R2 storage key — required for delete/verify
  folder          String? // products | stores | avatars | disputes | returns | blog | slider | promo
  status          String         @default("ready") // pending | ready | failed
  originalName    String?
  mimeType        String?
  sizeBytes       Int?
  width           Int? // original image width px
  height          Int? // original image height px
  durationSec     Int? // video duration — validated ≤ 15 sec for slider
  variants        Json? // Home media: { "400w": url, "800w": url, "1200w": url, "1600w": url }
  uploadedBy      String // user/seller ID who owns this asset
  verifiedAt      DateTime? // Set by media-processing job after R2 verification
  // Polymorphic relations — nullable, set when asset is attached to a record
  returnRequestId String?
  returnMessageId String?
  disputeId       String?
  createdAt       DateTime       @default(now())

  returnRequest              ReturnRequest?                     @relation(fields: [returnRequestId], references: [id])
  returnMessage              ReturnMessage?                     @relation(fields: [returnMessageId], references: [id])
  dispute                    Dispute?                           @relation(fields: [disputeId], references: [id])
  supportAttachments         SupportMessageAttachment[]
  customerSupportAttachments CustomerSupportMessageAttachment[] @relation("CustomerSupportAttachmentAsset")
  // Home CMS ilişkileri — bir asset birden fazla slotta kullanılabilir
  homeSlideMedia             HomeSlide[]                        @relation("HomeSlideMedia")
  homeSlidePoster            HomeSlide[]                        @relation("HomeSlidePoster")
  homePromoMedia             HomePromo[]                        @relation("HomePromoMedia")

  @@index([uploadedBy])
  @@index([uploadedBy, folder, status])
  @@index([returnMessageId])
  @@map("media_assets")
}

model SupportTicket {
  id                  String              @id @default(cuid())
  sellerId            String
  orderId             String?
  subject             String
  status              SupportTicketStatus @default(waiting_for_admin)
  resolvedAt          DateTime?
  lastSellerMessageAt DateTime?
  lastAdminMessageAt  DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  seller   Seller           @relation(fields: [sellerId], references: [id])
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([sellerId, status, updatedAt])
  @@index([orderId])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole UserRole
  body       String
  createdAt  DateTime @default(now())

  ticket      SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments SupportMessageAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("support_messages")
}

model SupportMessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  mediaAssetId String
  createdAt    DateTime @default(now())

  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([messageId, mediaAssetId])
  @@index([messageId])
  @@index([mediaAssetId])
  @@map("support_message_attachments")
}

model PlatformSettings {
  id                          String   @id @default("platform")
  standardPenaltyRate         Decimal  @default(0.2000) @db.Decimal(5, 4)
  dailyPenaltyRate            Decimal  @default(0.0100) @db.Decimal(5, 4) // Günlük geç sevkiyat ceza oranı (varsayılan %1)
  defaultSellerCommissionRate Decimal  @default(0.1500) @db.Decimal(5, 4)
  fulfillmentDays             Int      @default(20)
  fulfillmentWarningDays      Int      @default(5)
  payoutHoldDays              Int      @default(30)
  freeShippingThresholdTry    Decimal  @default(1500) @db.Decimal(12, 2)
  flatShippingFeeTry          Decimal  @default(99) @db.Decimal(12, 2)
  defaultTaxRate              Decimal  @default(0.2000) @db.Decimal(5, 4)
  commissionVatRate           Decimal  @default(0.2000) @db.Decimal(5, 4) // Komisyon kesintisine uygulanan KDV oranı (varsayılan %20)
  eftDiscountRate             Decimal  @default(0) @db.Decimal(5, 4)
  updatedBy                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("platform_settings")
}

// =============================================================================
// PLATFORM BANK ACCOUNTS — EFT/Havale için dinamik banka hesabı listesi
// =============================================================================

model PlatformBankAccount {
  id                String   @id @default(cuid())
  accountHolder     String
  accountHolderNote String? // Örn: "Hesap adı dar ise baştan sığdığı kadar yazabilirsiniz"
  bankName          String
  iban              String   @unique
  branchName        String?
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments Payment[]

  @@index([isActive, displayOrder])
  @@map("platform_bank_accounts")
}

// =============================================================================
// ADMIN AUDIT LOG — Tüm yüksek etkili admin işlemleri
// =============================================================================

// Audit log append-only'dir — güncelleme veya silme yapılmaz
model AdminAuditLog {
  id           String          @id @default(cuid())
  actorId      String // Admin kullanıcı ID
  actionType   AdminActionType
  targetType   String // 'order' | 'seller' | 'payout' | 'penalty' vb.
  targetId     String // Hedef kaydın ID'si
  previousData Json? // Değişiklik öncesi durum
  newData      Json? // Değişiklik sonrası durum
  reason       String? // Gerekçe (zorunlu olan action'larda)
  note         String? // Ek not
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([actionType, createdAt])
  @@map("admin_audit_logs")
}

// =============================================================================
// NOTIFICATION — Bildirimler
// =============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // Link veya ekstra context
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  eventKey       String
  userId         String
  type           NotificationType
  channel        NotificationChannel
  recipient      String
  status         NotificationDeliveryStatus @default(pending)
  notificationId String?
  attemptCount   Int                        @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([recipient, channel, eventKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

model StoreDiscountDispatch {
  id                  String    @id @default(cuid())
  userId              String
  sellerId            String
  discountRuleId      String?
  discountFingerprint String
  emailSentAt         DateTime?
  createdAt           DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerId, discountFingerprint])
  @@index([sellerId, createdAt])
  @@map("store_discount_dispatches")
}

// =============================================================================
// MARKETING CONSENT + CAMPAIGN DISPATCH — favori/sepet indirim e-postaları
// =============================================================================
// Tek bir kayıt onayı (signup checkbox) hem email hem sms zaman damgasını
// aynı anda set eder — iş kararı. Kanallar ileride ayrışabilir diye ayrı
// tutulur. Rıza olmayan/geri çekilmiş kullanıcı kampanya e-postası alamaz.

model MarketingConsent {
  id             String    @id @default(cuid())
  userId         String    @unique
  emailConsentAt DateTime?
  emailRevokedAt DateTime?
  smsConsentAt   DateTime?
  smsRevokedAt   DateTime?
  consentSource  String
  optOutToken    String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marketing_consents")
}

model CampaignEmailDispatch {
  id                  String                 @id @default(cuid())
  userId              String
  discountRuleId      String?
  productId           String?
  discountFingerprint String
  source              CampaignDispatchSource
  emailSentAt         DateTime?
  createdAt           DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, discountFingerprint, source])
  @@index([discountRuleId])
  // Per-user/product kampanya e-postası cooldown taraması (fingerprint'ten bağımsız).
  @@index([userId, productId, createdAt])
  @@map("campaign_email_dispatches")
}

// =============================================================================
// PRODUCT REVIEW — Ürün değerlendirme + moderasyon
// =============================================================================
// Kural: Yalnızca ürünü satın alıp delivery_confirmed durumuna ulaşan müşteri
// değerlendirme yazabilir. Her sipariş için ürün başına tek değerlendirme.
// İçerik moderasyonundan geçmeyen yorum public sayfada görünmez.

model ProductReview {
  id             String              @id @default(cuid())
  productId      String
  customerId     String
  orderId        String
  rating         Int // 1-5 (DB constraint migration'da)
  title          String?             @db.VarChar(140)
  body           String              @db.Text
  status         ProductReviewStatus @default(pending_moderation)
  moderatedBy    String? // Admin user ID
  moderatedAt    DateTime?
  moderationNote String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  // One review per (order, product) pair
  @@unique([orderId, productId])
  // Listing for product page (only approved, sorted by createdAt desc)
  @@index([productId, status, createdAt])
  // Admin moderation queue (status filter)
  @@index([status, createdAt])
  @@map("product_reviews")
}

// =============================================================================
// COUPON — Kupon / İndirim Kodu
// =============================================================================

enum CouponDiscountType {
  percentage // Yüzde indirim (örn. %10)
  fixed_amount // Sabit tutar indirimi (örn. 50₺)
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  sellerId        String?
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(12, 2) // Oran (0-100) veya sabit tutar
  minCartTotal    Decimal?           @db.Decimal(12, 2) // Minimum sepet tutarı
  maxUsageTotal   Int? // Toplam kullanım limiti (null = sınırsız)
  maxUsagePerUser Int                @default(1) // Kullanıcı başına limit
  usageCount      Int                @default(0) // Mevcut kullanım sayısı
  isActive        Boolean            @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  seller Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  usages CouponUsage[]

  @@index([code, isActive])
  @@index([expiresAt])
  @@index([sellerId])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique // Bir sipariş bir kupon kullanabilir
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// =============================================================================
// CUSTOMER SUPPORT TICKETS — Müşteri sipariş destek sistemi
// =============================================================================

model CustomerSupportTicket {
  id                    String                      @id @default(cuid())
  customerId            String
  orderId               String
  category              CustomerSupportCategory
  subject               String                      @db.VarChar(120)
  status                CustomerSupportTicketStatus @default(waiting_for_admin)
  resolvedAt            DateTime?
  resolvedById          String?
  resolutionNote        String?
  lastCustomerMessageAt DateTime?
  lastAdminMessageAt    DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  customer   User                     @relation("CustomerSupportTicketsAsCustomer", fields: [customerId], references: [id])
  order      Order                    @relation("OrderCustomerSupportTickets", fields: [orderId], references: [id])
  resolvedBy User?                    @relation("CustomerSupportTicketsAsResolver", fields: [resolvedById], references: [id])
  messages   CustomerSupportMessage[]

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([status, updatedAt])
  @@map("customer_support_tickets")
}

model CustomerSupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole UserRole
  body       String   @db.Text
  createdAt  DateTime @default(now())

  ticket      CustomerSupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                               @relation("CustomerSupportMessageAuthor", fields: [authorId], references: [id])
  attachments CustomerSupportMessageAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("customer_support_messages")
}

model CustomerSupportMessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  mediaAssetId String
  createdAt    DateTime @default(now())

  message    CustomerSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset             @relation("CustomerSupportAttachmentAsset", fields: [mediaAssetId], references: [id])

  @@unique([messageId, mediaAssetId])
  @@map("customer_support_message_attachments")
}

// =============================================================================
// ÜRÜN ÖZELLİK SEÇENEKLERİ — Renk / Materyal dropdown listeleri
// =============================================================================

model ProductAttributeOption {
  id        String               @id @default(cuid())
  type      ProductAttributeType
  label     String
  slug      String
  hexColor  String?
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())

  categories CategoryAttributeOption[]
  products   ProductAttributeValue[]

  @@unique([type, slug])
  @@index([type, isActive])
  @@map("product_attribute_options")
}

model CategoryAttributeOption {
  categoryId String
  optionId   String

  category Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  option   ProductAttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([categoryId, optionId])
  @@index([categoryId])
  @@map("category_attribute_options")
}

model ProductAttributeValue {
  productId String
  optionId  String
  // Tek üründe birden çok renk için görüntü sırası: Renk 1 → 0, Renk 2 → 1.
  // Materyal tek olduğundan 0'da kalır. (Palet/dropdown sırası ayrı kolondur:
  // ProductAttributeOption.sortOrder — karıştırılmamalı.)
  sortOrder Int    @default(0)

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  ProductAttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@index([productId])
  @@index([optionId])
  @@map("product_attribute_values")
}
