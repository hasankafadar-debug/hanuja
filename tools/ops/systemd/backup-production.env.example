# Copy this file to /etc/hanuja/backup-production.env, replace every value,
# then chmod 600 it. It must never be committed with real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hanuja_prod
PRIVATE_DOCUMENT_ROOT=/var/lib/hanuja/private-documents
RESTIC_REPOSITORY=rclone:gdrive:hanuja-production
RESTIC_PASSWORD_FILE=/etc/hanuja/restic-password
BACKUP_WORK_DIR=/var/lib/hanuja/backup-work
