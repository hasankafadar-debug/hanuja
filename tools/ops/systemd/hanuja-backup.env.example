# Copy to /etc/hanuja-backup/backup.env, replace every value, then chmod 600 it.
# Never commit real values. The application encryption key is not needed here:
# this backup only handles already-encrypted private-document bytes.
RESTIC_REPOSITORY=rclone:gdrive:hanuja-production
RESTIC_PASSWORD_FILE=/etc/hanuja-backup/restic-password
RCLONE_CONFIG=/etc/hanuja-backup/rclone.conf
RESTIC_CACHE_DIR=/var/cache/hanuja-restic
BACKUP_RECIPIENT=ops@example.com
