# ─────────────────────────────────────────────────────────────────────────────
# Hanuja — Customer Storefront (apps/web)
# Build context: repo root
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

# ── Install dependencies ───────────────────────────────────────────────────────
FROM base AS deps
WORKDIR /app

# Copy workspace manifests first (layer cache for dependency installs)
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY package.json ./
COPY api/package.json ./api/package.json
COPY db/package.json ./db/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/seo/package.json ./packages/seo/package.json
COPY packages/security/package.json ./packages/security/package.json
COPY apps/web/package.json ./apps/web/package.json
# Other apps' manifests are needed for workspace resolution
COPY apps/seller-panel/package.json ./apps/seller-panel/package.json
COPY apps/admin-panel/package.json ./apps/admin-panel/package.json

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

# ── Build ──────────────────────────────────────────────────────────────────────
FROM deps AS builder
WORKDIR /app

# Copy all source
COPY . .

# Generate Prisma client
RUN pnpm --filter @hanuja/db run generate

# Build only the web app (turbo will handle dependency graph)
RUN pnpm --filter web build

# ── Production runner ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Copy standalone build output
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
