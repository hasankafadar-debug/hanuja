# ─────────────────────────────────────────────────────────────────────────────
# Hanuja — BullMQ Worker (api/jobs)
# Runs payout-maturity, search-sync, notification,
# payout-batch, media-processing, fulfillment-risk workers.
# Build context: repo root
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

# ── Install dependencies ───────────────────────────────────────────────────────
FROM base AS deps
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
# pnpm applies patchedDependencies during install, so patches/ must be present here
COPY patches ./patches
COPY package.json ./
COPY api/package.json ./api/package.json
COPY db/package.json ./db/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/seo/package.json ./packages/seo/package.json
COPY packages/security/package.json ./packages/security/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/seller-panel/package.json ./apps/seller-panel/package.json
COPY apps/admin-panel/package.json ./apps/admin-panel/package.json

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

# ── Production runner ──────────────────────────────────────────────────────────
FROM deps AS runner
WORKDIR /app

COPY . .

# Generate Prisma client
RUN pnpm --filter @hanuja/db run generate

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 worker \
 && mkdir -p /app/.tmp/category-expansion \
 && chown -R worker:nodejs /app/.tmp
USER worker

# Apply pending Prisma migrations before any BullMQ process can use the new
# schema. `exec` keeps SIGTERM/SIGINT delivery correct for graceful shutdown.
CMD ["sh", "-c", "pnpm db:migrate:deploy && pnpm exec tsx tools/scripts/install-category-catalog.ts --apply && pnpm exec tsx tools/scripts/backfill-category-publication.ts --apply && pnpm exec tsx tools/scripts/prepare-category-search.ts && exec pnpm exec tsx api/jobs/worker-entrypoint.ts"]
